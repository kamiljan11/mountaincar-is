# Copy to .env.local and fill in real values. Never commit .env.local (it's gitignored).
# Every variable here is read in app/api/quote/route.ts. All of them are optional in code —
# if a whole group is unset, that side effect is skipped rather than erroring — but with
# NEITHER group set, a quote request is accepted and silently goes nowhere. See
# docs/quality/BACKLOG.md for that gap and docs/ARCHITECTURE.md for the full data flow.

# --- Supabase: persists quote requests to the `quotes` table (supabase/migrations/001_quotes.sql) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend: emails each quote request to a human ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, or sending fails. Falls back to
# "Mountain Car Website <onboarding@resend.dev>" in code if unset (Resend's own sandbox sender).
RESEND_FROM_EMAIL=
# Inbox that receives quote requests. Falls back to rental@mountaincar.is in code if unset.
RESEND_TO_EMAIL=
